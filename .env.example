# Supabase (required for live games)
# Set these in Vercel Project Settings → Environment Variables
# The Supabase ↔ Vercel integration often injects NEXT_PUBLIC_* names;
# the client also accepts those as fallbacks.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional aliases (read by src/lib/supabase.ts)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional TURN for live WebRTC (client-side fallback; prefer Edge secrets)
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Edge Function secrets (supabase secrets set ...):
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Legacy Convex vars (no longer used after migration)
# VITE_CONVEX_URL=
# CONVEX_SITE_URL=
# CONVEX_DEPLOYMENT=
